{
  "name": "family-ai-assistant",
  "version": "1.0.0",
  "description": "家族全員が自然言語で予定とタスクを一元管理できるAIアシスタントシステム",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/line-bot.js",
    "dev": "tsx src/index.ts",
    "bot": "tsx src/line-bot.ts",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "assistant",
    "calendar",
    "tasks",
    "google-calendar",
    "google-tasks",
    "claude",
    "family"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@line/bot-sdk": "^9.0.0",
    "express": "^4.18.2",
    "googleapis": "^128.0.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^5.0.5",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0"
  }
}

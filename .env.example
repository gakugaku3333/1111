# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Calendar & Tasks API
# 認証情報の設定方法:
# 1. Google Cloud Consoleでプロジェクトを作成
# 2. Google Calendar API & Google Tasks APIを有効化
# 3. OAuth 2.0クライアントIDを作成
# 4. credentials.jsonとしてダウンロードしてプロジェクトルートに配置

# 家族メンバー設定（カンマ区切り）
FAMILY_MEMBERS=父,母,長男,長女

# デフォルトのタイムゾーン
TIMEZONE=Asia/Tokyo

# LINE Bot API
# 設定方法:
# 1. LINE Developers (https://developers.line.biz/) でプロバイダーを作成
# 2. Messaging APIチャンネルを作成
# 3. Channel SecretとChannel Access Tokenを取得
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# サーバーポート（オプション）
PORT=3000
